[Unit]
Description=DardlashAI Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dardlashai
EnvironmentFile=/opt/dardlashai/.env
ExecStart=/opt/dardlashai/venv/bin/python bot.py
Restart=always
RestartSec=5
User=dardlashai

[Install]
WantedBy=multi-user.target

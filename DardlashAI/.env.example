# Если пусто — polling. Для продакшена полный URL, который должен дергать Telegram:
# WEBHOOK_URL=https://your.domain/telegram
WEBHOOK_URL=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=telegram

LOG_FILE=bot.log
PICKLE_PATH=bot_data.pkl
OPS_DB_PATH=ops.sqlite3

# Mini App аватара. Не путайте с Ollama и с WEBHOOK_URL.
# MINIAPP_PUBLIC_URL — то, что открывает Telegram (HTTPS).
# MINIAPP_PORT — внутренний порт на сервере, его в браузере не открывайте.
MINIAPP_ENABLED=1
MINIAPP_LISTEN=0.0.0.0
MINIAPP_PORT=8090
MINIAPP_PUBLIC_URL=
# Пример: MINIAPP_PUBLIC_URL=https://your.domain/avatar/
AVATAR_GLB_URL=
